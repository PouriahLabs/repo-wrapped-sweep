{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./vendor/src/*"]
    }
  },
  "include": ["vendor/**/*.ts", "src/**/*.ts", "test/**/*.ts", "tsup.config.ts", "vitest.config.ts"]
}
